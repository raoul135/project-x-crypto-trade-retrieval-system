      "id": "0c6b3a58-9d8f-4741-9ffe-1d01e34590ae",
      "name": "Webhook",
      "webhookId": "78912e8b-644d-490f-a561-5dfc545e2e7e"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json;\n\n// If data comes from Webhook, use raw.body.\n// If data comes from Manual Trigger/pinned data, use raw directly.\nconst item = raw.body ?? raw;\n\nconst user_id = item.user_id ?? null;\nconst email = item.email ?? null;\nconst wallet_address = item.wallet_address ?? null;\n\nconst subject = item.subject ?? null;\nconst timestamp = item.timestamp ?? null;\n\nconst pair = item.trade?.pair?.toUpperCase() ?? null;\nconst position_side = item.trade?.position_side?.toUpperCase() ?? null;\nconst order_type = item.trade?.order_type ?? null;\nconst order_id = item.trade?.order_id ?? null;\nconst exchange = item.trade?.exchange ?? null;\n\nconst strategy = item.bot_metadata?.strategy ?? null;\nconst version = item.bot_metadata?.version ?? null;\nconst risk_level = item.bot_metadata?.risk_level ?? null;\n\nconst trade_id = order_id ?? `TRADE-${Date.now()}`;\n\nreturn [{\n  json: {\n    ...item,\n    trade_id,\n    user_id,\n    email,\n    wallet_address,\n    subject,\n    timestamp,\n    pair,\n    position_side,\n    order_type,\n    order_id,\n    exchange,\n    strategy,\n    version,\n    risk_level\n  }\n}];"
      },
      "id": "30e35d15-538d-4e87-9da4-03e0a5cc9279",
      "name": "Normalize Input + Generate IDs1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1232,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\n\nconst required = {\n  trade_id: d.trade_id,\n  timestamp: d.timestamp,\n  pair: d.pair,\n  position_side: d.position_side,\n  order_type: d.order_type,\n  strategy: d.strategy\n};\n\nconst ontbrekend = Object.entries(required)\n  .filter(([_, value]) => value === null || value === undefined || value === '')\n  .map(([key]) => key);\n\nreturn [{\n  json: {\n    ...d,\n    resultaat: 'onvolledig',\n    actie: 'intake_validatie',\n    workflow_source: 'coordinator',\n    ontbrekende_velden: ontbrekend.join(', ')\n  }\n}];"
      },
