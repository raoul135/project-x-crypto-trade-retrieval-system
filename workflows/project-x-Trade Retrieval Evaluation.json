    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output[0].content[0].text;\n\nconst clean = raw.replace(/```json|```/g, \"\").trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = {\n    metric: \"unknown\",\n    score: 0,\n    comment: \"parse_error\"\n  };\n}\n\nreturn [{\n  json: {\n    metric: parsed.metric,\n    score: parsed.score,\n    comment: parsed.comment,\n    query: $(\"query+context\").first().json.query,\n    context: $(\"query+context\").first().json.context,\n    pair: $(\"Set Query\").first().json.pair,\n    top_k: $(\"Set Query\").first().json.top_k\n  }\n}];"
