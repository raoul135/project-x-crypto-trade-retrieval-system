    {
      "parameters": {
        "jsCode": "const itemsArr = items;\n\n// basis info\nconst result = {\n  Query_Text: itemsArr[0].json.query,\n  Context: itemsArr[0].json.context,\n  Pair: itemsArr[0].json.pair,\n  Top_k: itemsArr[0].json.top_k,\n\n  // metrics\n  Relevance: null,\n  Faithfulness: null,\n  Answer_Relevancy: null,\n  Context_Precision: null,\n  Context_Recall: null,\n  Harmfulness: 0\n};\n\n// loop door alle metric items\nfor (const item of itemsArr) {\n  const metric = item.json.metric;\n  const score = parseFloat(item.json.score);\n\n  if (metric === \"relevance\") {\n    result.Relevance = score;\n  }\n\n  if (metric === \"faithfulness\") {\n    result.Faithfulness = score;\n  }\n\n  if (metric === \"response_relevance\") {\n    result.Answer_Relevancy = score;\n  }\n\n  if (metric === \"precision\") {\n    result.Context_Precision = score;\n  }\n\n  if (metric === \"recall\") {\n    result.Context_Recall = score;\n  }\n\n  if (metric === \"harmfulness\") {\n    result.Harmfulness = score;\n  }\n}\n\n// return 1 rij\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
