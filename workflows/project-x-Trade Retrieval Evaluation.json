        "method": "POST",
        "url": "http://x-qdrant:6333/collections/trade-sentiment/points/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vector\": [{{$json.query_vector}}],\n  \"limit\": 50,\n  \"with_payload\": true,\n  \"with_vector\": false,\n  \"filter\": {\n    \"must\": [\n      {\n        \"key\": \"position_side\",\n        \"match\": { \"value\": \"LONG\" }\n      },\n      {\n        \"key\": \"trend_direction\",\n        \"match\": { \"value\": \"sideways\" }\n      },\n      {\n        \"key\": \"regime\",\n        \"match\": { \"value\": \"Short_neu_Long_neu\" }\n      },\n      {\n        \"key\": \"market_pressure_state\",\n        \"match\": { \"value\": \"neutral_pressure\" }\n      },\n      {\n        \"key\": \"dominant_driver\",\n        \"match\": { \"value\": \"NARRATIVE_SPECULATION\" }\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
