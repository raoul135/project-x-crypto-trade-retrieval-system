      "id": "c9e56cf7-e512-45c6-a4b9-b904f9ea5eda",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const trades = $json.result;\n\nconst context = trades.slice(0,5).map((t,i) => {\n  const p = t.payload;\n\n  return `Trade ${i+1}\nstrategy: ${p.strategy}\nposition: ${p.position_side}\ntrend: ${p.trend_direction}\nvolatility: ${p.volatility_category}\npressure: ${p.market_pressure_state}\nrsi: ${p.rsi_state}\nresult: ${p.result || \"open\"}\nscore: ${t.score}`;\n}).join(\"\\n\\n\");\n\nreturn [{\n  json: {\n    query: $node[\"Set Query\"].json.query_text,\n    context: context\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
