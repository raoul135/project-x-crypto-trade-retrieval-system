    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tradeData = item.json;\n\n// ---------- Safety Checks ----------\nif (!tradeData.trade) {\n  throw new Error(\"Trade data missing.\");\n}\n\nif (!tradeData.sentiment_snapshot) {\n  throw new Error(\"Sentiment snapshot missing.\");\n}\n\nconst s = tradeData.sentiment_snapshot;\n\n// ---------- Build Deterministic Vector Text ----------\nconst vector_text = `\nTRADE CONTEXT SNAPSHOT\n\nPAIR: ${tradeData.trade.pair}\nPOSITION: ${tradeData.trade.position_side}\nORDER TYPE: ${tradeData.trade.order_type}\nSTRATEGY: ${tradeData.bot_metadata.strategy}\n\nTECHNICAL STRUCTURE\nTrend Direction: ${tradeData.trend_direction}\nRSI Category: ${tradeData.categorized.rsi_category}\nVolatility Category: ${tradeData.categorized.volatility_category}\nTrend Strength: ${tradeData.categorized.trend_strength_category}\nPrice vs MA7: ${tradeData.categorized.price_vs_ma7_category}\nMarket Pressure: ${tradeData.embedding_context.market_pressure_state}\nRSI State: ${tradeData.embedding_context.rsi_state}\n\nSENTIMENT STRUCTURE\nShort Term Band: ${s.short_term_band}\nLong Term Band: ${s.long_term_band}\nRegime: ${s.regime}\nDominant Driver: ${s.dominant_driver}\nConfidence: ${s.confidence}\nDivergence: ${s.divergence}\n\nRISK STRUCTURE\nStop Loss: ${tradeData.risk_management.stop_loss}\nTake Profit 1: ${tradeData.risk_management.take_profit.tp1}\nTake Profit 2: ${tradeData.risk_management.take_profit.tp2}\nTrailing Stop: ${tradeData.risk_management.trailing_stop.enabled}\n`.trim();\n\n// ---------- Flat Payload (Optimized for Filtering) ----------\nconst payload = {\n  // Core Trade Info\n  pair: tradeData.trade.pair,\n  position_side: tradeData.trade.position_side,\n  order_type: tradeData.trade.order_type,\n  strategy: tradeData.bot_metadata.strategy,\n  order_id: tradeData.trade.order_id,\n  timestamp: tradeData.timestamp,\n\n  // Sentiment\n  short_term_avg: s.short_term_avg,\n  long_term_avg: s.long_term_avg,\n  short_term_band: s.short_term_band,\n  long_term_band: s.long_term_band,\n  regime: s.regime,\n  dominant_driver: s.dominant_driver,\n  sentiment_confidence: s.confidence,\n  divergence: s.divergence,\n\n  // Technical State\n  trend_direction: tradeData.trend_direction,\n  rsi_category: tradeData.categorized.rsi_category,\n  volatility_category: tradeData.categorized.volatility_category,\n  trend_strength_category: tradeData.categorized.trend_strength_category,\n  price_vs_ma7_category: tradeData.categorized.price_vs_ma7_category,\n  market_pressure_state: tradeData.embedding_context.market_pressure_state,\n  rsi_state: tradeData.embedding_context.rsi_state,\n\n  // Risk Parameters\n  stop_loss: tradeData.risk_management.stop_loss,\n  take_profit_1: tradeData.risk_management.take_profit.tp1,\n  take_profit_2: tradeData.risk_management.take_profit.tp2,\n  trailing_stop_enabled: tradeData.risk_management.trailing_stop.enabled,\n\n  // Market Snapshot\n  entry_price: tradeData.trade.execution.entry_price,\n  market_price_at_entry: tradeData.data.price_usd,\n  volatility: tradeData.data.volatility,\n  dominance_ratio: tradeData.data.dominance_ratio,\n  market_pressure_score: tradeData.data.market_pressure_score,\n\n  // ---------- Outcome (Initially Null) ----------\n  exit_price: null,\n  exit_timestamp: null,\n  pnl_usdt: null,\n  pnl_percent: null,\n  result: null,                 // \"win\" | \"loss\" | null\n  exit_reason: null,            // \"tp1\" | \"tp2\" | \"stop_loss\" | \"manual\" | null\n  holding_time_minutes: null,\n  rr_realized: null\n};\n\n// ---------- Stable ID ----------\nconst tradeId = `trade_${tradeData.trade.order_id}`;\n\n// ---------- Return Qdrant-ready Object ----------\nreturn {\n  json: {\n    id: tradeId,\n    vector_text,\n    payload\n  }\n};"
      },
