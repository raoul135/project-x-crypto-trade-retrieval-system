        "jsCode": "return items.map(item => {\n\n  const data = item.json;\n\n  // get id from nested trade object\n  const rawId = data.trade?.order_id || \"\";\n\n  // remove all non-digits (keeps only numbers)\n  const cleanId = rawId.replace(/\\D/g, \"\");\n\n  return {\n    json: {\n      id: cleanId,\n      payload: {\n        exit_price: data.exit_price,\n        exit_timestamp: data.exit_timestamp,\n        pnl_usdt: data.pnl_usdt,\n        pnl_percent: data.pnl_percent,\n        result: data.result,\n        exit_reason: data.exit_reason,\n        holding_time_minutes: data.holding_time_minutes,\n        rr_realized: data.rr_realized\n      }\n    }\n  };\n\n});"
      },
